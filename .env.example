# Core Runtime & Firebase Realtime Database Storage
APP_URL="http://localhost:3000"
FIREBASE_DATABASE_URL="https://livingtech-brand-agency-default-rtdb.firebaseio.com"
# Optional: Firebase Service Account JSON (raw JSON or base64) — recommended for Vercel/server persistence when App Check or strict RTDB rules are enabled
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Optional: Legacy Firebase Realtime Database secret for backend persistence
FIREBASE_DATABASE_SECRET=""
SESSION_SECRET=""
TOKEN_ENCRYPTION_KEY=""
GEMINI_API_KEY=""

# PHASE 3: AI CONTENT ENGINE, GRAPHIC GENERATION & DURABLE PUBLISHING WORKER
# Optional external image generation API (e.g., OpenAI Images / Stability / Flux endpoint)
IMAGE_GENERATION_API_URL=""
IMAGE_GENERATION_API_KEY=""
IMAGE_GENERATION_MODEL=""
# Only set true if you have enabled a billing-backed paid Gemini API key for Gemini image models
ENABLE_PAID_GEMINI_IMAGE_MODEL="false"

# Background Publishing Worker
# Embedded worker runs automatically inside server.ts (set "false" if running dedicated `npm run worker`)
ENABLE_EMBEDDED_WORKER="true"
WORKER_POLL_INTERVAL_MS="15000"
# Optional Redis connection string for horizontally scaled BullMQ deployments
REDIS_URL=""
